{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamKit",
  "version": "1.1.0",
  "identifier": "com.streamkit.suite",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3001/src/main.html",
    "frontendDist": "../src"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../src": "src",
      "../assets": "assets"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
